# Copy this file to .env and fill in the values before running docker compose.

# ── Required ──────────────────────────────────────────────────────────────────

# HMAC-HS256 key for JWT signing.  Use a random 32+ character string.
# Example: openssl rand -hex 32
JWT_SECRET=change-me-to-a-random-secret

# ── Optional (uncomment to override defaults) ─────────────────────────────────

# Port the proxy listens on (default: 8080)
# PROXY_PORT=8080

# Port the dashboard listens on (default: 8081)
# DASHBOARD_PORT=8081

# JWT token lifetime in seconds (default: 86400 = 24h)
# JWT_EXPIRY_SECS=86400

# Log filter for both services (tracing env-filter syntax)
# RUST_LOG=info
